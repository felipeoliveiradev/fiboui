{
  "name": "fiboui",
  "version": "2.6.4",
  "description": "Flutter/SwiftUI-inspired React UI — fluent builders, signals, and themes. https://fiboui.vercel.app",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-server": "./dist/server.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/server.js"
    },
    "./core": {
      "import": "./dist/core.js"
    },
    "./layout": {
      "import": "./dist/layout.js"
    },
    "./content": {
      "import": "./dist/content.js"
    },
    "./interactive": {
      "import": "./dist/interactive.js"
    },
    "./structure": {
      "import": "./dist/structure.js"
    },
    "./navigation": {
      "import": "./dist/navigation.js"
    },
    "./theme": {
      "import": "./dist/theme.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "fibo": "./dist/cli/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts && npm run build:dts && tsc --project tsconfig.cli.json",
    "build:dts": "dts-bundle-generator --no-check --export-referenced-types false --external-imports=@metagptx/css-to-tailwind --external-imports=react --external-imports=react-dom -o dist/index.d.ts src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ssr-e2e": "npm run build && npm --prefix examples/ssr-fixtures install && npm --prefix examples/ssr-fixtures run test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "secret-scan": "bash scripts/secret-scan.sh --dir",
    "secret-scan:git": "bash scripts/secret-scan.sh --git",
    "secret-scan:pack": "bash scripts/secret-scan.sh --pack",
    "prepublishOnly": "bash scripts/secret-scan.sh --pack",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "react",
    "ui",
    "framework",
    "flutter",
    "swiftui",
    "builder-pattern",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/felipeoliveiradev/fiboui"
  },
  "bugs": {
    "url": "https://github.com/felipeoliveiradev/fiboui/issues"
  },
  "homepage": "https://fiboui.vercel.app",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.8",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.16",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@metagptx/css-to-tailwind": "^0.0.4",
    "chalk": "^5.6.2",
    "clsx": "^2.1.0",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.3",
    "ora": "^9.0.0",
    "prompts": "^2.4.2",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.4.0"
  }
}
