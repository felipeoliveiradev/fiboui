{
  "name": "fiboui",
  "version": "1.0.3",
  "description": "A Flutter/SwiftUI-inspired React UI framework with builder pattern and theme system",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.esm.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "bin": {
    "fibo": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc --project tsconfig.cli.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "react",
    "ui",
    "framework",
    "flutter",
    "swiftui",
    "builder-pattern",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.8",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@metagptx/css-to-tailwind": "^0.0.4",
    "chalk": "^5.6.2",
    "clsx": "^2.1.0",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.3",
    "ora": "^9.0.0",
    "prompts": "^2.4.2",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.4.0"
  }
}
