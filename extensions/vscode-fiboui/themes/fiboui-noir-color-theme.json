    "badge.foreground": "#06241F",
    "button.background": "#4EC9B0",
    "button.foreground": "#06241F"
  },
  "tokenColors": [
    {
      "name": "FiboUI factories (Column, Row, Box…)",
      "scope": [
        "entity.name.function.ts",
        "entity.name.function.tsx",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Chain methods after dot",
      "scope": [
        "meta.method.declaration",
        "entity.name.function.member",
        "support.function.member"
      ],
      "settings": {
        "foreground": "#F4F4F5"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#CE9178" }
    },
    {
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": { "foreground": "#71717A", "fontStyle": "italic" }
    },
    {
      "scope": ["variable", "meta.definition.variable"],
      "settings": { "foreground": "#F4F4F5" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#B5CEA8" }
    },
    {
      "scope": ["punctuation.definition.parameters", "meta.brace.round", "meta.brace.square"],
      "settings": { "foreground": "#8A8A93" }
    }
  ]
}
