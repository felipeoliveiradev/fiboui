{
  "FiboUI Column": {
    "prefix": ["fcol", "fibocolumn"],
    "body": [
      "Column()",
      "  .crossAxisAlignment('${1:stretch}')",
      "  .spacing(${2:8})",
      "  .children([",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI Column() fluent tree"
  },
  "FiboUI Row": {
    "prefix": ["frow", "fiborow"],
    "body": [
      "Row()",
      "  .mainAxisAlignment('${1:spaceBetween}')",
      "  .crossAxisAlignment('${2:center}')",
      "  .children([",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI Row() fluent tree"
  },
  "FiboUI Scaffold": {
    "prefix": ["fscaffold", "fiboscaffold"],
    "body": [
      "Scaffold()",
      "  .headerBar(Header().children([Text('${1:Title}')]))",
      "  .children([",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI Scaffold() shell"
  },
  "FiboUI Box": {
    "prefix": ["fbox", "fibobox"],
    "body": [
      "Box()",
      "  .padding(${1:16})",
      "  .children([",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI Box() container"
  },
  "FiboUI Card": {
    "prefix": ["fcard", "fibocard"],
    "body": [
      "Card()",
      "  .padding(${1:16})",
      "  .children([",
      "    Text('${2:Title}'),",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI Card() with Text"
  },
  "FiboUI Center": {
    "prefix": ["fcenter"],
    "body": [
      "Center()",
      "  .children([",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI Center()"
  },
  "FiboUI Button": {
    "prefix": ["fbtn", "fibobutton"],
    "body": [
      "Button('${1:Label}')",
      "  .variant('${2:solid}')",
      "  .onPress(() => {",
      "    $0",
      "  })"
    ],
    "description": "FiboUI Button() chain"
  },
  "FiboUI Text": {
    "prefix": ["ftxt", "fibotext"],
    "body": ["Text('${1:Hello}').fontSize(${2:14})$0"],
    "description": "FiboUI Text()"
  },
  "FiboUI TextField": {
    "prefix": ["ffield", "fibotextfield"],
    "body": [
      "TextField()",
      "  .placeholder('${1:Email}')",
      "  .onChange((v) => {",
      "    $0",
      "  })"
    ],
    "description": "FiboUI TextField()"
  },
  "FiboUI ListTile": {
    "prefix": ["ftile", "fibolisttile"],
    "body": [
      "ListTile()",
      "  .title(Text('${1:Title}'))",
      "  .subtitle(Text('${2:Subtitle}'))",
      "  .chevron()",
      "  .onPress(() => {",
      "    $0",
      "  })"
    ],
    "description": "FiboUI ListTile()"
  },
  "FiboUI ScrollView": {
    "prefix": ["fscroll"],
    "body": [
      "ScrollView()",
      "  .children([",
      "    $0",
      "  ])"
    ],
    "description": "FiboUI ScrollView()"
  },
  "FiboUI children block": {
    "prefix": ["fch", "fibochildren"],
    "body": [
      ".children([",
      "  $0",
      "])"
    ],
    "description": "FiboUI .children([…]) block"
  }
}
